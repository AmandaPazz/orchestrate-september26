# Copy this file to .env (in the repo root, next to this file) and fill in the key(s) you
# have. .env is gitignored -- never commit real keys.
#
# Provider order at call time: Anthropic is tried first if ANTHROPIC_API_KEY is set; on
# any failure (or if it's not set at all), Gemini is used if GEMINI_API_KEY is set.
# Only one is required.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
